# Copy to .env and fill in real values. Never commit .env.
# PostgreSQL connection string (e.g. Neon)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Secret used to sign JWT access tokens — use a long random string
JWT_SECRET="change-me-to-a-long-random-string"
# Comma-separated frontend origin(s) allowed by CORS (in addition to localhost
# and the Render backend URL). Example: "https://app.skulpartners.com"
FRONTEND_URLS=""
